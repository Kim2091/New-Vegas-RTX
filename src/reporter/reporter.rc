// NewVegasRTX-Reporter.exe's version resource. build.bat writes
// reporter_version.h with the release tag (FNVR_VERSION_STR) and its numbers
// (FNVR_VERSION_NUM).
#include <winver.h>
#include "reporter_version.h"

1 VERSIONINFO
FILEVERSION FNVR_VERSION_NUM
PRODUCTVERSION FNVR_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "New Vegas RTX"
            VALUE "FileDescription", "New Vegas RTX session reporter"
            VALUE "FileVersion", FNVR_VERSION_STR
            VALUE "InternalName", "NewVegasRTX-Reporter"
            VALUE "OriginalFilename", "NewVegasRTX-Reporter.exe"
            VALUE "ProductName", "New Vegas RTX"
            VALUE "ProductVersion", FNVR_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
